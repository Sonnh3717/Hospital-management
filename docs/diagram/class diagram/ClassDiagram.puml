@startuml Hospital_Management_System_ClassDiagram
title Sơ đồ lớp tổng thể hệ thống Quản lý Bệnh viện (Hospital Management System Class Diagram)

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 6
skinparam shadowing false
skinparam packageStyle rectangle

' ==============================================================================
' MODULE 1: AUTHENTICATION & USER REGISTRATION
' ==============================================================================
package "Module: Authentication & Registration" {
    package "Auth Controllers" {
        class AuthController <<control>> {
            - authService: AuthService
            + login(request: LoginRequest): ResponseEntity<LoginResponse>
            + getCurrentUser(authorization: String): ResponseEntity<UserInfoResponse>
            + logout(authorization: String): ResponseEntity<Map<String, Object>>
            - extractToken(authorization: String): String
        }

        class PatientController <<control>> {
            - registrationService: PatientRegistrationService
            + register(command: RegisterCommand): ResponseEntity<RegisterResponse>
            + verifyOtp(command: VerifyOtpCommand): ResponseEntity<AuthResponse>
            + resendOtp(command: ResendOtpCommand): ResponseEntity<Map<String, Object>>
        }
    }

    package "Auth Services" {
        interface AuthService <<interface>> {
            + login(request: LoginRequest): LoginResponse
            + getCurrentUser(sessionId: String): UserInfoResponse
            + authenticate(token: String): StaffPrincipal
            + logout(sessionId: String): void
        }

        class AuthServiceImpl <<control>> {
            - userAccountRepository: UserAccountRepository
            - authSessionRepository: AuthSessionRepository
            - hospitalStaffRepository: HospitalStaffRepository
            - patientRepository: PatientRepository
            - passwordEncoder: PasswordEncoder
            + login(request: LoginRequest): LoginResponse
            + getCurrentUser(sessionId: String): UserInfoResponse
            + authenticate(token: String): StaffPrincipal
            + logout(sessionId: String): void
            - buildUserInfo(account: UserAccount): UserInfoResponse
        }

        interface PatientRegistrationService <<interface>> {
            + registerPatient(command: RegisterCommand): RegisterResponse
            + verifyRegistration(command: VerifyOtpCommand): AuthResponse
            + resendOtp(email: String): void
        }

        class PatientRegistrationServiceImpl <<control>> {
            - verificationRepository: RegistrationVerificationRepository
            - userAccountRepository: UserAccountRepository
            - patientRepository: PatientRepository
            - roleRepository: RoleRepository
            - emailService: RegistrationEmailService
            - passwordEncoder: PasswordEncoder
            + registerPatient(command: RegisterCommand): RegisterResponse
            + verifyRegistration(command: VerifyOtpCommand): AuthResponse
            + resendOtp(email: String): void
        }

        class RegistrationEmailService <<service>> {
            - mailSender: JavaMailSender
            + sendOtpEmail(toEmail: String, otpCode: String): void
        }
    }

    package "Auth Repositories" {
        interface UserAccountRepository <<interface>> {
            + findForLogin(login: String): Optional<UserAccount>
            + findByUsername(username: String): Optional<UserAccount>
            + findByLoginEmail(loginEmail: String): Optional<UserAccount>
            + save(account: UserAccount): UserAccount
        }

        interface AuthSessionRepository <<interface>> {
            + findForAuthentication(id: String): Optional<AuthSession>
            + save(session: AuthSession): AuthSession
        }

        interface RoleRepository <<interface>> {
            + findByRoleCode(roleCode: RoleCode): Optional<Role>
        }

        interface RegistrationVerificationRepository <<interface>> {
            + findByEmailAndStatus(email: String, status: VerificationStatus): Optional<RegistrationVerification>
            + save(verification: RegistrationVerification): RegistrationVerification
        }
    }

    package "Auth Entities" {
        enum RoleCode <<enumeration>> {
            ADMIN
            MANAGER
            DOCTOR
            MEDICAL_SERVICE_STAFF
            RECEPTIONIST
            PATIENT
        }

        enum ActiveStatus <<enumeration>> {
            ACTIVE
            INACTIVE
        }

        enum RevocationReason <<enumeration>> {
            LOGOUT
            ACCOUNT_DISABLED
            PASSWORD_RESET
        }

        enum VerificationStatus <<enumeration>> {
            PENDING
            VERIFIED
            EXPIRED
        }

        class Role <<entity>> {
            - id: Short
            - roleCode: RoleCode
            - roleName: String
        }

        class UserAccount <<entity>> {
            - id: Long
            - role: Role
            - username: String
            - loginEmail: String
            - passwordHash: String
            - status: ActiveStatus
            - passwordChangedAt: LocalDateTime
        }

        class AuthSession <<entity>> {
            - id: String
            - userAccount: UserAccount
            - expiresAt: LocalDateTime
            - revokedAt: LocalDateTime
            - revocationReason: RevocationReason
        }

        class RegistrationVerification <<entity>> {
            - id: Long
            - email: String
            - otpHash: String
            - fullName: String
            - phone: String
            - dateOfBirth: LocalDate
            - gender: Gender
            - passwordHash: String
            - expiresAt: LocalDateTime
            - status: VerificationStatus
        }
    }

    package "Auth DTOs" {
        class LoginRequest {
            - username: String
            - password: String
        }

        class LoginResponse {
            - token: String
            - user: UserInfoResponse
        }

        class UserInfoResponse {
            - id: Long
            - username: String
            - email: String
            - role: String
            - fullName: String
        }

        class RegisterCommand {
            - fullName: String
            - email: String
            - password: String
            - phone: String
            - dateOfBirth: LocalDate
            - gender: Gender
        }

        class VerifyOtpCommand {
            - email: String
            - otpCode: String
        }
    }
}

' ==============================================================================
' MODULE 2: APPOINTMENT & SCHEDULING MANAGEMENT
' ==============================================================================
package "Module: Appointment & Scheduling" {
    package "Appointment Controllers" {
        class AppointmentController <<control>> {
            - appointmentService: AppointmentService
            + getAvailableSlots(date: LocalDate, doctorId: Long): ResponseEntity<List<AvailableSlotResponse>>
            + createOnlineBooking(request: CreateBookingRequest, principal: UserPrincipal): ResponseEntity<AppointmentResponse>
            + checkInAppointment(appointmentId: Long, principal: StaffPrincipal): ResponseEntity<AppointmentResponse>
            + undoCheckIn(appointmentId: Long, request: UndoCheckInRequest, principal: StaffPrincipal): ResponseEntity<AppointmentResponse>
            + cancelAppointment(appointmentId: Long, request: CancelAppointmentRequest, principal: UserPrincipal): ResponseEntity<AppointmentResponse>
            + rescheduleAppointment(appointmentId: Long, request: RescheduleAppointmentRequest, principal: UserPrincipal): ResponseEntity<AppointmentResponse>
        }

        class ReceptionAppointmentController <<control>> {
            - receptionService: ReceptionAppointmentService
            + list(actor: StaffPrincipal, date: LocalDate, doctorId: Long, status: Status, search: String, page: int, size: int): PageView<AppointmentView>
            + options(actor: StaffPrincipal, date: LocalDate): ReceptionOptions
            + create(actor: StaffPrincipal, input: CreateAppointment): AppointmentView
            + checkIn(actor: StaffPrincipal, id: Long): AppointmentView
            + undoCheckIn(actor: StaffPrincipal, id: Long): AppointmentView
            + cancel(actor: StaffPrincipal, id: Long, reason: String): AppointmentView
            + reschedule(actor: StaffPrincipal, id: Long, destinationId: Long): AppointmentView
        }
    }

    package "Appointment Services" {
        interface AppointmentService <<interface>> {
            + getAvailableSlots(date: LocalDate, doctorId: Long): List<AvailableSlotResponse>
            + createAppointment(request: CreateBookingRequest, accountId: Long): AppointmentResponse
            + checkInAppointment(appointmentId: Long, staffAccountId: Long): AppointmentResponse
            + undoCheckIn(appointmentId: Long, request: UndoCheckInRequest, staffAccountId: Long): AppointmentResponse
            + cancelAppointment(appointmentId: Long, request: CancelAppointmentRequest, accountId: Long, isPatient: boolean): AppointmentResponse
            + rescheduleAppointment(appointmentId: Long, request: RescheduleAppointmentRequest, accountId: Long, isPatient: boolean): AppointmentResponse
        }

        class AppointmentServiceImpl <<control>> {
            - appointmentRepository: AppointmentRepository
            - appointmentSlotRepository: AppointmentSlotRepository
            - patientRepository: PatientRepository
            - hospitalStaffRepository: HospitalStaffRepository
            - encounterRepository: EncounterRepository
            - userAccountRepository: UserAccountRepository
            + getAvailableSlots(date: LocalDate, doctorId: Long): List<AvailableSlotResponse>
            + createAppointment(request: CreateBookingRequest, accountId: Long): AppointmentResponse
            + checkInAppointment(appointmentId: Long, staffAccountId: Long): AppointmentResponse
            + undoCheckIn(appointmentId: Long, request: UndoCheckInRequest, staffAccountId: Long): AppointmentResponse
            + cancelAppointment(appointmentId: Long, request: CancelAppointmentRequest, accountId: Long, isPatient: boolean): AppointmentResponse
            + rescheduleAppointment(appointmentId: Long, request: RescheduleAppointmentRequest, accountId: Long, isPatient: boolean): AppointmentResponse
        }

        interface ReceptionAppointmentService <<interface>> {
            + list(actor: StaffPrincipal, date: LocalDate, doctorId: Long, status: Status, search: String, page: int, size: int): PageView<AppointmentView>
            + options(actor: StaffPrincipal, date: LocalDate): ReceptionOptions
            + create(actor: StaffPrincipal, input: CreateAppointment): AppointmentView
            + checkIn(actor: StaffPrincipal, id: Long): AppointmentView
            + undoCheckIn(actor: StaffPrincipal, id: Long): AppointmentView
            + cancel(actor: StaffPrincipal, id: Long, reason: String): AppointmentView
            + reschedule(actor: StaffPrincipal, id: Long, destinationId: Long): AppointmentView
        }

        class ReceptionAppointmentServiceImpl <<control>> {
            - appointments: AppointmentRepository
            - slots: AppointmentSlotRepository
            - patients: PatientRepository
            - doctors: DoctorProfileRepository
            - staff: HospitalStaffRepository
            - accounts: UserAccountRepository
            + list(actor: StaffPrincipal, date: LocalDate, doctorId: Long, status: Status, search: String, page: int, size: int): PageView<AppointmentView>
            + options(actor: StaffPrincipal, date: LocalDate): ReceptionOptions
            + create(actor: StaffPrincipal, input: CreateAppointment): AppointmentView
            + checkIn(actor: StaffPrincipal, id: Long): AppointmentView
            + undoCheckIn(actor: StaffPrincipal, id: Long): AppointmentView
            + cancel(actor: StaffPrincipal, id: Long, reason: String): AppointmentView
            + reschedule(actor: StaffPrincipal, id: Long, destinationId: Long): AppointmentView
            - validateSlot(slot: AppointmentSlot, source: BookingSource): void
            - ensureCapacity(slot: AppointmentSlot): void
        }
    }

    package "Appointment Repositories" {
        interface AppointmentRepository <<interface>> {
            + findById(id: Long): Optional<Appointment>
            + save(appointment: Appointment): Appointment
        }

        interface AppointmentSlotRepository <<interface>> {
            + findById(id: Long): Optional<AppointmentSlot>
            + save(slot: AppointmentSlot): AppointmentSlot
        }
    }

    package "Appointment Entities" {
        enum AppointmentStatus <<enumeration>> {
            BOOKED
            CHECKED_IN
            CANCELLED
            NO_SHOW
            COMPLETED
        }

        enum BookingSource <<enumeration>> {
            ONLINE
            ASSISTED
            WALK_IN
        }

        enum SlotStatus <<enumeration>> {
            OPEN
            BLOCKED
        }

        class Appointment <<entity>> {
            - id: Long
            - appointmentCode: String
            - patient: Patient
            - appointmentSlot: AppointmentSlot
            - bookingSource: BookingSource
            - status: AppointmentStatus
            - reason: String
            - note: String
            - cancellationReason: String
            - cancelledAt: LocalDateTime
            - checkedInAt: LocalDateTime
            - checkedInByStaff: HospitalStaff
            - lastCheckInReversedAt: LocalDateTime
            - lastCheckInReversedByStaff: HospitalStaff
            - lastRescheduledAt: LocalDateTime
            - createdByAccount: UserAccount
        }

        class AppointmentSlot <<entity>> {
            - id: Long
            - workSchedule: WorkSchedule
            - appointmentRule: AppointmentRule
            - startsAt: LocalDateTime
            - endsAt: LocalDateTime
            - capacity: Short
            - status: SlotStatus
        }

        class AppointmentRule <<entity>> {
            - id: Long
            - ruleCode: String
            - ruleName: String
            - slotDurationMinutes: Integer
            - defaultCapacity: Integer
            - minBookingNoticeMinutes: Integer
            - maxBookingDaysAhead: Integer
            - active: Boolean
        }

        class WorkSchedule <<entity>> {
            - id: Long
            - staff: HospitalStaff
            - shiftTemplate: ShiftTemplate
            - startsAt: LocalDateTime
            - endsAt: LocalDateTime
            - status: ScheduleStatus
        }

        class ShiftTemplate <<entity>> {
            - id: Long
            - shiftCode: String
            - shiftName: String
            - startTime: LocalTime
            - endTime: LocalTime
        }

        class Patient <<entity>> {
            - id: Long
            - userAccount: UserAccount
            - patientCode: String
            - fullName: String
            - dateOfBirth: LocalDate
            - gender: Gender
            - phone: String
            - contactEmail: String
            - address: String
        }

        class HospitalStaff <<entity>> {
            - id: Long
            - staffCode: String
            - fullName: String
            - employmentStatus: ActiveStatus
        }
    }

    package "Appointment DTOs" {
        class CreateAppointment {
            + patientId: Long
            + patient: NewPatient
            + slotId: Long
            + bookingSource: BookingSource
            + reason: String
            + idempotencyKey: String
        }

        class AppointmentView {
            + id: Long
            + appointmentCode: String
            + patient: PatientView
            + doctor: DoctorView
            + slot: SlotView
            + bookingSource: String
            + status: String
            + reason: String
            + checkedInAt: String
        }
    }
}

' ==============================================================================
' MODULE 3: DOCTOR CONSULTATION & COMPLETE ENCOUNTER
' ==============================================================================
package "Module: Doctor Consultation & Encounter" {
    package "Clinical Controllers" {
        class DoctorClinicalController <<control>> {
            - clinicalService: DoctorClinicalService
            + worklist(actor: StaffPrincipal, date: LocalDate, status: String, page: int, size: int): PageView<WorklistView>
            + start(actor: StaffPrincipal, id: Long): StartView
            + get(actor: StaffPrincipal, id: Long): EncounterView
            + history(actor: StaffPrincipal, id: Long): List<EncounterView>
            + examination(actor: StaffPrincipal, id: Long, input: ExaminationInput): EncounterView
            + treatment(actor: StaffPrincipal, id: Long, input: TreatmentInput): EncounterView
            + createRequest(actor: StaffPrincipal, id: Long, input: RequestInput): EncounterView
            + review(actor: StaffPrincipal, id: Long, resultId: Long, input: ReviewInput): EncounterView
            + complete(actor: StaffPrincipal, id: Long): EncounterView
        }
    }

    package "Clinical Services" {
        interface DoctorClinicalService <<interface>> {
            + worklist(actor: StaffPrincipal, date: LocalDate, status: String, page: int, size: int): PageView<WorklistView>
            + start(actor: StaffPrincipal, appointmentId: Long): StartView
            + get(actor: StaffPrincipal, encounterId: Long): EncounterView
            + history(actor: StaffPrincipal, encounterId: Long): List<EncounterView>
            + catalogue(actor: StaffPrincipal): List<ServiceView>
            + examination(actor: StaffPrincipal, id: Long, input: ExaminationInput): EncounterView
            + treatment(actor: StaffPrincipal, id: Long, input: TreatmentInput): EncounterView
            + createRequest(actor: StaffPrincipal, id: Long, input: RequestInput): EncounterView
            + editRequest(actor: StaffPrincipal, id: Long, requestId: Long, input: RequestEditInput): EncounterView
            + cancelRequest(actor: StaffPrincipal, id: Long, requestId: Long, input: ReasonInput): EncounterView
            + review(actor: StaffPrincipal, id: Long, resultId: Long, input: ReviewInput): EncounterView
            + complete(actor: StaffPrincipal, id: Long): EncounterView
            + attachment(actor: StaffPrincipal, id: Long, requestId: Long): Download
        }

        class DoctorClinicalServiceImpl <<control>> {
            - encounters: EncounterRepository
            - diagnoses: EncounterDiagnosisRepository
            - treatments: EncounterTreatmentRepository
            - followUps: EncounterFollowUpRepository
            - requests: MedicalServiceRequestRepository
            - results: MedicalServiceResultRepository
            - reviews: ServiceResultReviewRepository
            - appointments: AppointmentRepository
            - doctors: DoctorProfileRepository
            - mapper: ClinicalMapper
            + worklist(actor: StaffPrincipal, date: LocalDate, status: String, page: int, size: int): PageView<WorklistView>
            + start(actor: StaffPrincipal, appointmentId: Long): StartView
            + get(actor: StaffPrincipal, encounterId: Long): EncounterView
            + history(actor: StaffPrincipal, encounterId: Long): List<EncounterView>
            + catalogue(actor: StaffPrincipal): List<ServiceView>
            + examination(actor: StaffPrincipal, id: Long, input: ExaminationInput): EncounterView
            + treatment(actor: StaffPrincipal, id: Long, input: TreatmentInput): EncounterView
            + createRequest(actor: StaffPrincipal, id: Long, input: RequestInput): EncounterView
            + editRequest(actor: StaffPrincipal, id: Long, requestId: Long, input: RequestEditInput): EncounterView
            + cancelRequest(actor: StaffPrincipal, id: Long, requestId: Long, input: ReasonInput): EncounterView
            + review(actor: StaffPrincipal, id: Long, resultId: Long, input: ReviewInput): EncounterView
            + complete(actor: StaffPrincipal, id: Long): EncounterView
            + attachment(actor: StaffPrincipal, id: Long, requestId: Long): Download
            - authorized(actor: StaffPrincipal, id: Long, lock: boolean): Encounter
            - open(encounter: Encounter): void
        }

        class ClinicalMapper <<mapper>> {
            - diagnoses: EncounterDiagnosisRepository
            - treatments: EncounterTreatmentRepository
            - followUps: EncounterFollowUpRepository
            - requests: MedicalServiceRequestRepository
            - results: MedicalServiceResultRepository
            - reviews: ServiceResultReviewRepository
            + encounter(encounter: Encounter): EncounterView
            + blockers(encounter: Encounter): List<String>
        }
    }

    package "Clinical Repositories" {
        interface EncounterRepository <<interface>> {
            + findById(id: Long): Optional<Encounter>
            + save(encounter: Encounter): Encounter
        }

        interface EncounterDiagnosisRepository <<interface>> {
            + findByEncounterId(encounterId: Long): List<EncounterDiagnosis>
            + save(diagnosis: EncounterDiagnosis): EncounterDiagnosis
        }

        interface EncounterTreatmentRepository <<interface>> {
            + findByEncounterId(encounterId: Long): Optional<EncounterTreatment>
            + save(treatment: EncounterTreatment): EncounterTreatment
        }

        interface MedicalServiceRequestRepository <<interface>> {
            + findByEncounterId(encounterId: Long): List<MedicalServiceRequest>
            + save(request: MedicalServiceRequest): MedicalServiceRequest
        }

        interface MedicalServiceResultRepository <<interface>> {
            + findByRequestId(requestId: Long): Optional<MedicalServiceResult>
            + save(result: MedicalServiceResult): MedicalServiceResult
        }

        interface ServiceResultReviewRepository <<interface>> {
            + findByResultId(resultId: Long): Optional<ServiceResultReview>
            + save(review: ServiceResultReview): ServiceResultReview
        }
    }

    package "Clinical Entities" {
        enum EncounterStatus <<enumeration>> {
            IN_PROGRESS
            COMPLETED
        }

        enum DiagnosisType <<enumeration>> {
            PRIMARY
            SECONDARY
        }

        enum RequestStatus <<enumeration>> {
            ORDERED
            IN_PROGRESS
            COMPLETED
            CANCELLED
        }

        class Encounter <<entity>> {
            - id: Long
            - appointment: Appointment
            - responsibleDoctor: DoctorProfile
            - status: EncounterStatus
            - startedAt: LocalDateTime
            - completedAt: LocalDateTime
            - chiefComplaint: String
            - symptoms: String
            - clinicalFindings: String
            - clinicalNotes: String
        }

        class EncounterDiagnosis <<entity>> {
            - id: Long
            - encounter: Encounter
            - icdCode: String
            - diseaseName: String
            - diagnosisType: DiagnosisType
            - isSuspected: Boolean
            - notes: String
        }

        class EncounterTreatment <<entity>> {
            - id: Long
            - encounter: Encounter
            - decisionText: String
            - instructions: String
            - followUpRequired: Boolean
        }

        class EncounterFollowUp <<entity>> {
            - id: Long
            - encounter: Encounter
            - requestedDate: LocalDate
            - reason: String
            - notes: String
        }

        class MedicalServiceRequest <<entity>> {
            - id: Long
            - encounter: Encounter
            - requestCode: String
            - serviceDefinition: MedicalServiceDefinition
            - status: RequestStatus
            - priority: Priority
            - requestedAt: LocalDateTime
        }

        class MedicalServiceResult <<entity>> {
            - id: Long
            - medicalServiceRequest: MedicalServiceRequest
            - summary: String
            - details: String
            - attachmentUrl: String
            - completedAt: LocalDateTime
        }

        class ServiceResultReview <<entity>> {
            - id: Long
            - medicalServiceResult: MedicalServiceResult
            - reviewingDoctor: DoctorProfile
            - reviewNotes: String
            - handlingDecision: String
            - reviewedAt: LocalDateTime
        }

        class DoctorProfile <<entity>> {
            - id: Long
            - staff: HospitalStaff
            - licenseNumber: String
            - specialization: String
            - isActive: Boolean
        }
    }

    package "Clinical DTOs" {
        class ExaminationInput {
            + chiefComplaint: String
            + symptoms: String
            + clinicalFindings: String
            + clinicalNotes: String
            + diagnoses: List<DiagnosisInput>
        }

        class TreatmentInput {
            + decisionText: String
            + instructions: String
            + followUpRequired: Boolean
            + followUps: List<FollowUpInput>
        }

        class ReviewInput {
            + reviewNotes: String
            + handlingDecision: String
        }

        class EncounterView {
            + id: Long
            + appointmentId: Long
            + status: String
            + chiefComplaint: String
            + symptoms: String
            + clinicalFindings: String
            + diagnoses: List<DiagnosisView>
            + treatment: TreatmentView
            + requests: List<ServiceRequestView>
            + blockers: List<String>
        }
    }
}

' ==============================================================================
' INTER-MODULE RELATIONSHIPS & ASSOCIATIONS
' ==============================================================================
AuthController ..> AuthService : uses
PatientController ..> PatientRegistrationService : uses
AuthServiceImpl ..|> AuthService : implements
PatientRegistrationServiceImpl ..|> PatientRegistrationService : implements
PatientRegistrationServiceImpl ..> RegistrationEmailService : uses
AuthServiceImpl ..> UserAccountRepository : uses
AuthServiceImpl ..> AuthSessionRepository : uses
PatientRegistrationServiceImpl ..> RegistrationVerificationRepository : uses
PatientRegistrationServiceImpl ..> UserAccountRepository : uses

AppointmentController ..> AppointmentService : uses
ReceptionAppointmentController ..> ReceptionAppointmentService : uses
AppointmentServiceImpl ..|> AppointmentService : implements
ReceptionAppointmentServiceImpl ..|> ReceptionAppointmentService : implements

DoctorClinicalController ..> DoctorClinicalService : uses
DoctorClinicalServiceImpl ..|> DoctorClinicalService : implements
DoctorClinicalServiceImpl ..> ClinicalMapper : uses

' Entity Associations
UserAccount "0..*" --> "1" Role : role
AuthSession "0..*" --> "1" UserAccount : userAccount
Patient "0..1" --> "0..1" UserAccount : userAccount

Appointment "0..*" --> "1" Patient : patient
Appointment "0..*" --> "1" AppointmentSlot : appointmentSlot
Appointment "0..*" --> "0..1" HospitalStaff : checkedInByStaff
AppointmentSlot "0..*" --> "1" WorkSchedule : workSchedule
AppointmentSlot "0..*" --> "1" AppointmentRule : appointmentRule
WorkSchedule "0..*" --> "1" ShiftTemplate : shiftTemplate
WorkSchedule "0..*" --> "1" HospitalStaff : staff

Encounter "0..*" --> "1" Appointment : appointment
Encounter "0..*" --> "1" DoctorProfile : responsibleDoctor
EncounterDiagnosis "0..*" --> "1" Encounter : encounter
EncounterTreatment "0..1" --> "1" Encounter : encounter
EncounterFollowUp "0..*" --> "1" Encounter : encounter
MedicalServiceRequest "0..*" --> "1" Encounter : encounter
MedicalServiceResult "1" --> "1" MedicalServiceRequest : medicalServiceRequest
ServiceResultReview "0..1" --> "1" MedicalServiceResult : medicalServiceResult
DoctorProfile "0..*" --> "1" HospitalStaff : staff

@enduml

